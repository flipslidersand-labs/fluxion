{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "draft-pull-request": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "crates/fluxion-core/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/fluxion-host/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/fluxion-worker/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/fluxion-cli/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='fluxion-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='fluxion-host')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='fluxion-worker')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value=='fluxion-cli')].version" }
      ]
    }
  }
}
